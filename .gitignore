# ---- 权重与数据：不进仓库（体积大、且是二进制）----
models/
*.pt
*.onnx
*.engine
*.trt
data/
datasets/
runs/
*.mp4
*.avi
*.mkv

# ---- 旧项目遗留目录（已从 git 移除，磁盘保留便于对照）----
training_pipeline/
training_scripts/
__pycache__/
*.pyc

# ---- 运行产物 ----
logs/
alerts/
*.log
.env
config/local.yaml

# ---- 误入库的备份与训练数据（清理用）----
*.bak
*.bak_*
training_data/
backups/

# ---- 训练产出物：参数/指标/曲线/最优权重入库，训练集不入库 ----
# （training_artifacts 里只有单份 best.pt，约 5MB，直接走普通 git，不上 LFS）
!training_artifacts/**/*.pt
!training_artifacts/**/*.json
